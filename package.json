{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "scripts": {
    "dev": "pnpm --recursive --parallel dev",
    "build": "pnpm --recursive build",
    "typecheck": "tsc --build",
    "check": "biome check",
    "publish-packages": "pnpm --filter './packages/*' build && changeset publish",
    "version-packages": "changeset version",
    "test": "pnpm --filter './apps/storybook' test",
    "test:storybook": "pnpm test --project=storybook",
    "test:react:unit": "pnpm test --project=unit",
    "test:react:e2e": "pnpm test --project=e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@changesets/config": "catalog:",
    "typescript": "catalog:"
  }
}
