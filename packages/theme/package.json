{
  "name": "@lanekassen/ds-theme",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "default": "./dist/lanekassen.css"
    }
  },
  "scripts": {
    "build": "pnpm run tokens:create && pnpm run tokens:build && pnpm build:tidy",
    "build:tidy": "rm dist/colors.d.ts",
    "tokens:create": "designsystemet tokens create",
    "tokens:build": "designsystemet tokens build --clean --out-dir dist"
  },
  "devDependencies": {
    "@digdir/designsystemet": "^1.14.0",
    "@digdir/designsystemet-types": "^1.14.0"
  }
}
