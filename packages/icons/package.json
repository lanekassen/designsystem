    "dev": "tsdown --watch",
    "build": "tsc --build && tsdown"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
