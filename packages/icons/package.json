{
  "name": "@lanekassen/ds-icons",
  "version": "0.4.3",
  "type": "module",
  "author": "Lånekassen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanekassen/designsystem.git"
  },
  "homepage": "https://github.com/lanekassen/designsystem/blob/main/packages/icons",
  "license": "MIT",
  "keywords": [
    "icons",
    "designsystem",
    "lanekassen"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
