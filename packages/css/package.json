{
  "name": "@lanekassen/ds-css",
  "version": "0.2.1",
  "type": "module",
  "author": "Lånekassen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanekassen/designsystem.git"
  },
  "homepage": "https://github.com/lanekassen/designsystem/blob/main/packages/css",
  "license": "MIT",
  "keywords": [
    "css",
    "designsystem",
    "lanekassen"
  ],
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./dist/index.css"
    },
    "./theme": {
      "types": "./theme/types.d.ts",
      "default": "./theme/lanekassen.css"
    },
    "./theme/tailwind": {
      "types": "./theme/types.d.ts",
      "default": "./theme/lanekassen.tailwind.css"
    },
    "./components/*": "./dist/components/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "pnpm theme:build && tsdown",
    "theme:build": "pnpm theme:tokens:create && pnpm theme:tokens:build && pnpm theme:build:tidy",
    "theme:build:tidy": "rm theme/colors.d.ts",
    "theme:tokens:create": "designsystemet tokens create",
    "theme:tokens:build": "designsystemet tokens build --experimental-tailwind --clean --out-dir theme/"
  },
  "files": [
    "dist/",
    "theme/",
    "types.d.ts",
    "package.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@digdir/designsystemet": "^1.15.0",
    "@digdir/designsystemet-css": "^1.15.0",
    "@tsdown/css": "^0.22.1",
    "tsdown": "^0.22.1"
  }
}
